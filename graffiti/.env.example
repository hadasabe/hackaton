PORT=3001
COOKIE_SECRET=change-me
JWT_SECRET=change-me-too
ADMIN_NAME=Редакция
ADMIN_EMAIL=admin@stena.local
# Пароль администратора задаётся только здесь, в коде его нет.
# Оставьте пустым — при первом запуске будет сгенерирован случайный пароль.
ADMIN_PASSWORD=

# AI-предпроверка: mock | deepseek | openai | ollama
# Для демо без ключа используйте mock.
AI_PROVIDER=deepseek
AI_MODEL=deepseek-flash
AI_AUTO_PUBLISH=false
AI_TIMEOUT_MS=25000

# DeepSeek (OpenAI-совместимый API)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# OpenAI — альтернатива
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Локальная модель через Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5vl:7b
